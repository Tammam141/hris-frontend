# Base URL backend HRIS, TANPA "/api/v1" dan TANPA "/" di akhir
# (client.ts sudah menambahkan "/api/v1" sendiri).
# Production / Preview:
#   - Vercel: isi di Project Settings → Environment Variables
#   - VM: isi di GitHub repo → Settings → Secrets and variables → Actions → tab Variables
#     (dipakai sebagai build arg Docker oleh workflow ci.yml dan deploy.yml).
#   VITE_API_BASE_URL=https://<DOMAIN_API>
# Development: boleh DIKOSONGKAN supaya request lewat proxy Vite (vite.config.js -> http://127.0.0.1:8080).
VITE_API_BASE_URL=

# URL WebSocket notifikasi real-time.
# Production / Preview:
#   - Vercel: isi di Project Settings → Environment Variables
#   - VM: isi di GitHub repo → Settings → Secrets and variables → Actions → tab Variables
#     (dipakai sebagai build arg Docker oleh workflow ci.yml dan deploy.yml).
#   VITE_WS_URL=wss://<DOMAIN_API>/ws
# Development: boleh DIKOSONGKAN supaya memakai ws://<origin>/ws lewat proxy Vite.
VITE_WS_URL=

# Catatan: variabel VITE_ dibaca saat BUILD, bukan saat runtime.
# Setelah mengubah env di Vercel atau GitHub Actions Variables, lakukan Redeploy / re-trigger build.

